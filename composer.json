{
  "name": "luberan/balikovna-woocommerce",
  "description": "Development tools for the Balikovna for WooCommerce plugin.",
  "license": "GPL-3.0-or-later",
  "require-dev": {
    "ext-zip": "*",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "erusev/parsedown": "1.8.0",
    "php-stubs/woocommerce-stubs": "11.2.0",
    "php-stubs/wordpress-stubs": "7.1.2",
    "phpcompatibility/php-compatibility": "10.0.0-alpha2",
    "phpcompatibility/phpcompatibility-paragonie": "^2.0@alpha",
    "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.13",
    "symfony/yaml": "^5.4",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-cli/i18n-command": "^2.7",
    "wp-cli/wp-cli": "^2.12",
    "wp-coding-standards/wpcs": "^3.2"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "platform": {
      "php": "7.4.33"
    },
    "sort-packages": true
  },
  "scripts": {
    "analyse": "@php vendor/phpstan/phpstan/phpstan analyse --no-progress --memory-limit=1G",
    "build": "@php .github/scripts/build-plugin.php",
    "lint": "@php -d error_reporting=8191 vendor/squizlabs/php_codesniffer/bin/phpcs --standard=phpcs.xml.dist",
    "pot": "@php -d error_reporting=8191 vendor/wp-cli/wp-cli/php/boot-fs.php i18n make-pot . languages/balikovna-wc.pot --slug=balikovna-woocommerce --domain=balikovna-wc --exclude=build,vendor,tests,includes/lib --package-name=\"Balíkovna for WooCommerce\" --file-comment=\"Translation template for Balíkovna for WooCommerce.\"",
    "test": "phpunit --configuration phpunit.xml.dist",
    "test:integration": "@php vendor/phpunit/phpunit/phpunit --configuration phpunit.integration.xml.dist",
    "vendor:check": "@php .github/scripts/vendor-parsedown.php --check"
  }
}

{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "packages": {
    ".": {
      "package-name": "balikovna-woocommerce",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        {
          "type": "generic",
          "path": "balikovna-woocommerce.php"
        },
        {
          "type": "generic",
          "path": "readme.txt"
        }
      ]
    }
  },
  "changelog-sections": [
    { "type": "feat",      "section": "🚀 Nové funkce" },
    { "type": "fix",       "section": "🐛 Opravy chyb" },
    { "type": "compat",    "section": "🔧 Kompatibilita" },
    { "type": "perf",      "section": "⚡ Výkon" },
    { "type": "refactor",  "section": "♻️ Refaktor" },
    { "type": "docs",      "section": "📚 Dokumentace" },
    { "type": "i18n",      "section": "🌍 Lokalizace" },
    { "type": "ci",        "section": "🛠 CI", "hidden": false },
    { "type": "build",     "section": "🛠 Build", "hidden": false },
    { "type": "chore",     "section": "🧹 Údržba", "hidden": true },
    { "type": "test",      "section": "✅ Testy", "hidden": true },
    { "type": "style",     "section": "Styl", "hidden": true }
  ]
}
